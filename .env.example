# LLM routing — OpenRouter (OpenAI-compatible API; routes to any model)
# Get a key at https://openrouter.ai/settings/keys (free tier, no credit card)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenAI gpt-oss-120b (free tier) by default — works well and avoids the
# Venice-provider rate limits that hit Llama / Qwen free models.
# Browse free models: https://openrouter.ai/models?max_price=0
# To use Claude (paid, ~$0.0008/call): anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_VIDEO_RESOLUTION=720p
OPENROUTER_VIDEO_DURATION=10
OPENROUTER_VIDEO_ASPECT_RATIO=16:9
# Music generation (Google Lyria 3 via OpenRouter; ~$0.04 per 30s clip)
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview
# Audio-input model used for the personalized demo's "listen to my track" step
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
# Vision model used for the personalized demo's "look at my outfit photos" step
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Optional: path to ffmpeg for muxing Lyria audio into completed Seedance MP4s
FFMPEG_PATH=ffmpeg

# Legacy / unused (kept so old .env files don't fail validation)
ANTHROPIC_API_KEY=

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=./nocturne.db

# n8n Cloud (v1 workflow automation)
# Example: https://your-workspace.app.n8n.cloud
N8N_CLOUD_WORKSPACE_URL=
# Filled after the booking confirmation workflow's Webhook node is created.
N8N_BOOKING_WEBHOOK=

# AI Integrations (optional — for future use)
SUNO_API_KEY=
ELEVENLABS_API_KEY=
